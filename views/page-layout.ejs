<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/page-style.css">
    <title>lastdayonearth.<%= page %></title>
  </head>
  <body>

    <div class="layout">
      <header>
        <h1>lastdayonearth<span>.<%= page %></span></h1>
        <nav>
          <ul>
            <li><a href="/posts">posts</a></li>
            <li><a href="/tasks">tasks</a></li>
            <li><a href="/resume">resume</a></li>
          </ul>
        </nav>
      </header>

      <main>
        <aside class="profile-card">
          <div class="profile-card__avatar">
            <img class="image" src="/images/nine.jpg" width="256" height="256">
          </div>
          <div class="profile-card__info">
            <div class="profile-card__info-name">
              <span class="fullname">Ruan Carlos Lins Mendes</span>
              <span class="username">rclm</span>
            </div>
            <div class="profile-card__info-links">
              <ul>
                <li><a href="https://github.com/xkazu0x" target="_blank">GitHub</a></li>
                <li><a href="https://www.linkedin.com/in/ruan-carlos-lins-mendes/" target="_blank">LinkedIn</a></li>
              </ul>
            </div>
          </div>
        </aside>
        <%- include("pages/" + page) %>
      </main>

      <footer>
        <ul>
          <li class="slogan">lastdayonearth</li>
          <li>© 2026 Ruan Carlos Lins Mendes</li>
        </ul>
      </footer>
    </div>

  </body>
</html>

