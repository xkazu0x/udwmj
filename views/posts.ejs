<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/page-style.css">
    <title>lastdayonearth.posts</title>
  </head>
  <body>

    <header>
      <h1>lastdayonearth<span>.posts</span></h1>
      <nav>
        <ul>
          <li><a href="">posts</a></li>
          <li><a href="">projects</a></li>
          <li><a href="">resume</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <aside class="profile">
        <div class="profile-avatar">
          <img class="image" src="/images/avatar.png" width="256" height="256">
        </div>
        <div class="profile-name">
          <span class="fullname">Ruan Carlos Lins Mendes</span>
          <span class="nickname">rclm</span>
        </div>
        <div class="profile-links">
          <ul>
            <li><a href="https://github.com/xkazu0x" target="_blank">github</a></li>
            <li><a href="https://www.linkedin.com/in/ruan-carlos-lins-mendes/" target="_blank">linkedin</a><S-Del></li>
          </ul>
        </div>
      </aside>

      <content class="post-container">
        <ul>
          <% posts.forEach(post => { %>
          <li>
            <article class="post">
              <date><%= post.date %></date>
              <a href=""><%= post.title %></a>
              <div class="post-description">
                <p><%= post.description %></p>
              </div>
            </article>
          </li>
          <% }) %>
        </ul>
      </content>
    </main>

    <footer>
    </footer>

  </body>
</html>

