<% if (data.length === 0) { %>
  <section class="empty-content-card">
    <p>It's a little empty in here...</p>
  </section>
<% } else { %>

  <section class="content-card">
    <div class="content-card__post-card">
      <ul>
        <% data.forEach(post => { %>
          <li>
            <article class="content-card__post">
              <date><%= post.date %></date>
              <a href=""><%= post.title %></a>
              <div class="content-card__post-desc">
                <p><%= post.desc %></p>
              </div>
            </article>
          </li>
        <% }) %>
      </ul>
    </div>
  </section>

<% } %>
