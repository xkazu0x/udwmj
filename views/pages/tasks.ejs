<section class="content-card">
  <ul>
    <% data.forEach(post => { %>
      <li>
        <article class="content-card__post">
          <date><%= post.date %></date>
          <a href="<%= post.path %>" target="__blank"><%= post.title %></a>
          <div class="content-card__post-desc">
            <p><%= post.desc %></p>
          </div>
        </article>
      </li>
    <% }) %>
  </ul>
</section>
