<section class="post-container">
  <ul>
    <% data.forEach(post => { %>
      <li>
        <article class="post">
          <date><%= post.date %></date>
          <a href="<%= post.path %>" target="__blank"><%= post.title %></a>
          <div class="post-description">
            <p><%= post.description %></p>
          </div>
        </article>
      </li>
    <% }) %>
  </ul>
</section>
