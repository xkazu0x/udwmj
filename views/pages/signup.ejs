<section class="sign-card">
  <div class="sign-card__header">
    <h2 class="sign-card__header-title">lastdayonearth</h2>
    <p class="sign-card__header-subtitle">Create your account</p>
  </div>

  <div class="sign-card__input-section">
    <form action="/signup" method="POST">
      <div class="sign-card__input">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="Enter your full name">
      </div>

      <div class="sign-card__input">
        <label for="email">Email Address <span class="sign-card__input-required">*</span></label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required>
      </div>

      <div class="sign-card__input">
        <label for="username">Username <span class="sign-card__input-required">*</span></label>
        <input type="text" id="username" name="username" placeholder="Create a username" required>
      </div>

      <div class="sign-card__input">
        <label for="password">Password <span class="sign-card__input-required">*</span></label>
        <input type="password" id="password" name="password" placeholder="Create a password" minlength="8" required>
      </div>

      <div class="sign-card__input">
        <label for="confirm-password">Confirm Password <span class="sign-card__input-required">*</span></label>
        <input type="password" id="confirm-password" name="confirm_password" placeholder="Confirm your password" minlength="8" required>
      </div>

      <button type="submit" class="sign-card__button">Sign up</button>
    </form>
  </div>

  <div class="sign-card__footer">
    <p>Already have an account? <a href="/">Sign in</a></p>
  </div>
</section>
